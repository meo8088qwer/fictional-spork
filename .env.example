# Supabase project connection (client-side, safe to expose — RLS enforces access control).
# Get these from your Supabase project: Project Settings -> API.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# GEMINI_API_KEY is NOT set here anymore -- the AI coach call runs in a Supabase
# Edge Function (supabase/functions/ai-coach), so the key lives in Supabase secrets
# (`supabase secrets set GEMINI_API_KEY=...`), never in this app's env.

# Toss Payments client key (public, safe to expose -- starts with test_ck_ or
# live_ck_). Only used client-side to open the card-registration widget.
# TOSS_SECRET_KEY is NOT set here -- it lives in Supabase Edge Function
# secrets only (`supabase secrets set TOSS_SECRET_KEY=...`), same reasoning
# as GEMINI_API_KEY above. Never put the secret key in this file.
VITE_TOSS_CLIENT_KEY="test_ck_YOUR_TOSS_CLIENT_KEY"
